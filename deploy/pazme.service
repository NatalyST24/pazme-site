[Unit]
Description=PAZME web application
After=network.target

[Service]
Type=simple
User=pazme
Group=pazme
WorkingDirectory=/opt/pazme
Environment=PAZME_DB=/var/lib/pazme/pazme.sqlite3
ExecStart=/opt/pazme/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8765 --timeout 30 app:application
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/pazme

[Install]
WantedBy=multi-user.target
